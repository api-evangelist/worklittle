{
  "issuer": "https://api.worklittle.com",
  "authorization_endpoint": "https://api.worklittle.com/oauth/authorize",
  "token_endpoint": "https://api.worklittle.com/oauth/token",
  "registration_endpoint": "https://api.worklittle.com/oauth/register",
  "scopes_supported": [
    "jobs:read",
    "jobs:apply",
    "jobs:apply_with_ai",
    "openid",
    "email",
    "profile"
  ],
  "response_types_supported": [
    "code"
  ],
  "grant_types_supported": [
    "authorization_code",
    "refresh_token"
  ],
  "code_challenge_methods_supported": [
    "S256"
  ],
  "token_endpoint_auth_methods_supported": [
    "none",
    "client_secret_post"
  ],
  "client_id_metadata_document_supported": true,
  "resource_indicators_supported": true
}